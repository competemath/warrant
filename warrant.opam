# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "A Lean 4 kernel whose only currency is provenance-indexed evidence"
description:
  "WARRANT checks lean4export files. Every fact the checker relies on is an evidence value minted by one function and stamped with the environment it holds in; metadata in a file is a claim that becomes a fact only by re-derivation."
maintainer: ["Mikael Bashir"]
authors: ["WARRANT contributors"]
license: "Apache-2.0"
homepage: "https://github.com/competemath/warrant"
bug-reports: "https://github.com/competemath/warrant/issues"
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.16" & >= "3.16"}
  "zarith" {>= "1.12"}
  "yojson" {>= "2.0"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/competemath/warrant.git"
