; The fuzzer needs bisect_ppx, an opam package that is not a dependency of WARRANT: it is built only in the profile "fuzz"
;   dune build --profile fuzz --instrument-with bisect_ppx ./tools/fuzz/fuzz.exe

(executable
 (name fuzz)
 (enabled_if
  (= %{profile} fuzz))
 (libraries warrant yojson unix bisect_ppx.common bisect_ppx.runtime))
